# Local-only config, sourced by the Makefile via `-include .env`.
# Rename to .env and fill with your values if you'd like to sign and install on an actual iPhone

# Signing materials (dev identity). `sign-app` reads these from env.
DEVCERT=/Users/user/Documents/DirectoryWithDevCerts
P12_PASS=YourPassword

# Apple Developer Team ID (also feeds Info.plist + DEVELOPMENT_TEAM).
TEAM_ID=A1111ABCDE

# Signing command used by `make signed` (defaults to tools/sign-app).
SIGN_CMD=$(CURDIR)/tools/sign-app --keychain-prefix ax.lx.ipipe

# Device UDID for `make install/launch` (DEVICE defaults to this, else "iPhone").
UDID_IPHONE=00008110-XXXXXXXXXXXXXXXX

# Bundled cookies delivered to the device after `make install`.
COOKIESFILE=/absolute/path/to/cookies.txt
